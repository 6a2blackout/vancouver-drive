{
  "name": "vancouver-drive",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Open-world night driving game set in a geometrically accurate Vancouver, built from the city's open LiDAR-derived data.",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "fetch": "tsx tools/fetch.ts",
    "world": "tsx tools/build-world.ts",
    "test:vehicle": "tsx tools/test-vehicle.ts",
    "test:terrain": "tsx tools/test-terrain.ts",
    "test:roads": "tsx tools/test-roads.ts",
    "test": "npm run test:vehicle && npm run test:terrain && npm run test:roads"
  },
  "dependencies": {
    "@dimforge/rapier3d-compat": "^0.19.3",
    "three": "^0.185.1"
  },
  "devDependencies": {
    "@types/node": "^26.1.2",
    "@types/proj4": "^2.5.6",
    "@types/three": "^0.185.2",
    "proj4": "^2.21.0",
    "tsx": "^4.23.1",
    "typescript": "^7.0.2",
    "vite": "^8.2.0"
  }
}
